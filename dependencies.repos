repositories:
  # naoqi_libqi and naoqi_libqicore are not listed: rosdep installs them from apt
  # (ros-<distro>-naoqi-libqi, ros-<distro>-naoqi-libqicore), as the README says.
  # This fork's interfaces (RunLed, PlayAudio, the audio services, ...).
  naoqi_bridge_msgs:
    type: git
    url: https://github.com/yohatad/naoqi_bridge_msgs2.git
    version: main
  nao_meshes:
    type: git
    url: https://github.com/ros-naoqi/nao_meshes2.git
    version: main
  pepper_meshes:
    type: git
    url: https://github.com/ros-naoqi/pepper_meshes2.git
    version: main
